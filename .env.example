# Required server configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/noka_dev
APP_URL=http://localhost:3000
SESSION_SECRET=replace-with-at-least-32-characters-random-secret

# Optional local fallback upload path (defaults to .data/uploads outside public/)
LOCAL_UPLOADS_DIR=.data/uploads

# Optional S3 / Cloudflare R2 object storage (provide all required fields when enabled)
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Optional Resend transactional email (provide both fields when enabled)
RESEND_API_KEY=
EMAIL_FROM=

